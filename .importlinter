# Redis and logline are tandem's runtime dependencies; the test tools are dev-only and tandem imports
# none of them. The contracts below run over the real import graph.
[importlinter]
include_external_packages = True
root_packages =
    tandem

[importlinter:contract:tandem-imports-no-test-tool]
name = tandem imports no test-only dependency
type = forbidden
source_modules =
    tandem
forbidden_modules =
    fakeredis
    lupa
    pytest
    pytest_asyncio
    pytest_cov
    xdist

[importlinter:contract:tandem-imports-no-structlog]
name = tandem imports no structlog
type = forbidden
source_modules =
    tandem
forbidden_modules =
    structlog
